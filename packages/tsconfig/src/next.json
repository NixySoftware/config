{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "paths": {
            "~/*": ["./src/*"]
        },
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "extends": "./react.json",
    "include": ["next-env.d.ts", ".next/dev/types", ".next/types/", "src/"]
}
