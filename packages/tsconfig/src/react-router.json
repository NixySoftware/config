{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "paths": {
            "~/*": ["./app/*"],
            "~assets/*": ["./assets/*"]
        },
        "rootDirs": [".", "./.react-router/types"],
        "types": ["@react-router/node", "vite/client", "vitest"]
    },
    "extends": "./react.json",
    "include": ["react-router.config.ts", "vite.config.ts", ".react-router/types/**/*", "app/"]
}
