{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "build": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "cache": false,
            "dependsOn": ["@nixysoftware/eslint-config#build", "^lint"]
        }
    }
}
